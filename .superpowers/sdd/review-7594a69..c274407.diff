 function coverUrl(game) {
   if (!game.cover) return null;
   try {
     const stat = fs.statSync(game.cover);
     return `${COVER_SCHEME}${encodeURIComponent(path.basename(game.cover))}?v=${Math.round(
       stat.mtimeMs
     )}`;
   } catch {
     return null;
   }
 }

